# ---------------------------------------------------------------------------
# VDMS environment configuration
# Copy this file to `.env` and fill in the values. Never commit `.env`.
# Only VITE_* variables are exposed to the frontend bundle.
# ---------------------------------------------------------------------------

# Public Supabase project URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Public anon key (safe for the browser; protected by Row Level Security)
VITE_SUPABASE_ANON_KEY=your-anon-key

# Application metadata
VITE_APP_VERSION=1.0.0
VITE_ENVIRONMENT=development

# Display timezone (frozen default: Europe/Moscow)
VITE_APP_TIMEZONE=Europe/Moscow

# Session inactivity timeout in minutes (frozen: 30) and warning lead time (frozen: 5)
VITE_SESSION_TIMEOUT_MINUTES=30
VITE_SESSION_WARNING_MINUTES=5
